local.properties

# 🔥 忽略 Gradle 构建产物目录。
#
# 注意：`**/build/` 同时会匹配 Java 包目录（例如
# `com/android/purebilibili/build/`），因此必须紧跟以下否定规则，
# 否则 build-logic 的插件源码会被静默忽略、无法提交。
**/build/
!build-logic/src/main/java/com/android/purebilibili/build/
!build-logic/src/main/java/com/android/purebilibili/build/**
!app/src/main/java/com/android/purebilibili/build/
!app/src/main/java/com/android/purebilibili/build/**

# 🔥 忽略 Kotlin 编译器临时文件和错误日志
*.compiler.options
.kotlin/
*.log

# 🔥 忽略敏感配置文件
*.keystore
*.jks
google-services.json
signing.properties
keystore.properties

# 🔥 忽略其他临时文件
*.tmp
*.bak
*.swp
*~

# 🔥 忽略 IDE 相关
.idea/
.vscode/
*.ipr
*.iws

# 🔥 忽略测试报告
/reports/

# 🔥 忽略 APK 和发布文件
*.apk
*.aab
**/release/
app/release/

# 🔥 忽略 AI/Agent 相关文件
