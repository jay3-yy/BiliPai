    <string name="process_memory_glossary">指标说明</string>
    <string name="process_memory_pss_description">比例集大小（Proportional Set Size），表示按比例归到当前进程的内存。私有页面全额计入，共享页面按进程分摊。例如 20 MiB 由两个进程共享，各计入 10 MiB。Android 的总 PSS 也可能计入按比例分摊的交换页。</string>
    <string name="process_memory_rss_description">常驻集大小（Resident Set Size），表示当前驻留在物理内存中的页面大小。共享页面会全额计入每个使用它的进程。</string>
    <string name="process_memory_swap_description">当前进程被换出到交换区的页面总量。设备使用 zRAM 时，这些页面会压缩保存。</string>
    <string name="process_memory_java_heap_description">Android 运行时管理的堆，主要存放 Kotlin 和 Java 对象。</string>
    <string name="process_memory_native_heap_description">通过原生分配器申请的堆内存，例如 C/C++ 库分配的内存。</string>
    <string name="process_memory_code_description">映射到进程的程序代码与静态资源，例如 APK、DEX、共享库和字体。</string>
    <string name="process_memory_stack_description">线程用于保存函数调用和局部变量的内存。</string>
    <string name="process_memory_graphics_description">系统归到进程的图形缓冲区及渲染相关内存。</string>
    <string name="process_memory_private_other_description">进程独占、未归入前述分类的内存，例如部分运行时开销。</string>
    <string name="process_memory_system_description">Android 归到系统与共享的内存份额，例如运行库和系统框架的共享页面。</string>
    <string name="process_memory_units_description">1 KiB 等于 1,024 字节，1 MiB 等于 1,024 KiB。</string>
    <string name="process_memory_overlay_title">应用内内存浮窗</string>
