<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_playback_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_tab_watch_later"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="@string/watchlater_bangumi_widget_tab_later"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/widget_playback_accent" />

        <TextView
            android:id="@+id/widget_tab_bangumi"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="@string/watchlater_bangumi_widget_tab_bangumi"
            android:textSize="13sp"
            android:textColor="@color/widget_playback_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:importantForAccessibility="no" />

        <ImageButton
            android:id="@+id/widget_refresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:padding="6dp"
            android:src="@drawable/ms_refresh_24"
            android:tint="@color/widget_playback_text"
            android:contentDescription="@string/watchlater_bangumi_widget_refresh" />
    </LinearLayout>

    <ListView
        android:id="@+id/widget_feed_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="4dp" />

    <TextView
        android:id="@+id/widget_feed_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="12dp"
        android:text="@string/watchlater_bangumi_widget_loading"
        android:textSize="13sp"
        android:textColor="@color/widget_playback_text"
        android:visibility="gone" />
</LinearLayout>
